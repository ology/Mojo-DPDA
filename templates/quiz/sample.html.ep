% layout 'default';

% my %wiki_link = (
%   Paranoid     => 'Paranoid_personality_disorder',
%   Schizoid     => 'Schizoid_personality_disorder',
%   Schizotypal  => 'Schizotypal_personality_disorder',
%   Antisocial   => 'Antisocial_personality_disorder',
%   Borderline   => 'Borderline_personality_disorder',
%   Histrionic   => 'Histrionic_personality_disorder',
%   Narcissistic => 'Narcissistic_personality_disorder',
%   Avoidant     => 'Avoidant_personality_disorder',
%   Dependent    => 'Dependent_personality_disorder',
%   OC           => 'Obsessive%E2%80%93compulsive_personality_disorder',
% );
% my @categories = sort keys %wiki_link;

%# A representative, mixed sample result - matches sample-chart.png
% my %sample_scores = (
%   Paranoid     => { prop => '9.2%',  score => '2.750', discord => '1.222', diff => '1.528' },
%   Schizoid     => { prop => '35.1%', score => '6.556', discord => '0.741', diff => '5.815' },
%   Schizotypal  => { prop => '5.9%',  score => '3.000', discord => '2.020', diff => '0.980' },
%   Antisocial   => { prop => '5%',    score => '1.500', discord => '0.667', diff => '0.833' },
%   Borderline   => { prop => '2.1%',  score => '2.750', discord => '2.407', diff => '0.343' },
%   Histrionic   => { prop => '0.6%',  score => '2.944', discord => '2.840', diff => '0.105' },
%   Narcissistic => { prop => '9.2%',  score => '3.045', discord => '1.515', diff => '1.530' },
%   Avoidant     => { prop => '23.2%', score => '7.312', discord => '3.472', diff => '3.840' },
%   Dependent    => { prop => '6%',    score => '2.222', discord => '1.235', diff => '0.988' },
%   OC           => { prop => '3.7%',  score => '3.333', discord => '2.716', diff => '0.617' },
% );

%# The three flat, illustrative "extreme" cases - every category scores
%# identically, so proportion is a uniform 10% across the board.
% my %no_disorder_scores  = map { $_ => { prop => '10.0%', score => '1.000',  discord => '0.000', diff => '1.000'  } } @categories;
% my %inconclusive_scores = map { $_ => { prop => '10.0%', score => '5.500',  discord => '5.500', diff => '0.000'  } } @categories;
% my %all_disorder_scores = map { $_ => { prop => '10.0%', score => '10.000', discord => '0.000', diff => '10.000' } } @categories;

% my $build_rows = sub {
%   my $scores = shift;
%   return [ map { { name => $_, link => $wiki_link{$_}, %{ $scores->{$_} } } } @categories ];
% };

<p>
This page shows a typical, mixed sample result alongside the three
extreme cases the test can produce: no disorders detected, an
inconclusive (highly discordant) result, and every disorder scoring
at its maximum.
</p>

<h3 class="mt-4">Sample Result</h3>
<%= include 'partials/score_table',
    heading   => 'Mixed sample',
    chart_url => url_for('/images/sample-chart.png'),
    chart_alt => 'Sample results chart',
    rows      => $build_rows->(\%sample_scores) %>

<h3>Extreme Cases</h3>

<%= include 'partials/score_table',
    heading   => 'No Disorders',
    chart_url => url_for('/images/dpda-no-disorder.png'),
    chart_alt => 'No disorders chart',
    rows      => $build_rows->(\%no_disorder_scores) %>

<%= include 'partials/score_table',
    heading   => 'Inconclusive',
    chart_url => url_for('/images/dpda-inconclusive.png'),
    chart_alt => 'Inconclusive chart',
    rows      => $build_rows->(\%inconclusive_scores) %>

<%= include 'partials/score_table',
    heading   => 'All Disorders',
    chart_url => url_for('/images/dpda-disordered.png'),
    chart_alt => 'All disorders chart',
    rows      => $build_rows->(\%all_disorder_scores) %>

<p class="mt-4">Link to the question file: <a href="<%= url_for('/dpda-questions.txt') %>">DPDA Questions</a></p>
<p>Link to the code: <a href="https://github.com/ology/Mojo-DPDA">DPDA</a></p>

<p class="mt-3 fw-bold">* REMEMBER to save this result page. *</p>
