<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= stash('title') // 'DPDA' %></title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/bootstrap.bundle.min.js"></script>
  <script src="/js/jquery-4.0.0.min.js"></script>
</head>
<body>
<div class="container py-4">

  <header class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <h1 class="h3 mb-2 mb-md-0">Dimensional Personality Disorder Assessment</h1>
    <nav class="nav">
      <a class="nav-link" href="<%= url_for('overview') %>">Overview</a>
      <a class="nav-link" href="<%= url_for('sample') %>">Sample Results</a>
      <a class="nav-link" href="<%= url_for('question') %>">Start Quiz</a>
    </nav>
  </header>

  <main>
    <%= content %>
  </main>

  <footer class="text-center text-muted small mt-5 pt-3 border-top">
    &copy; Copyright 1999-<%= (localtime)[5] + 1900 %>
    <a href="https://obits.oregonlive.com/us/obituaries/oregon/name/timothy-butcher-obituary?pid=160646732">Timothy W. Butcher</a>
    and <a href="http://gene.ology.net/">Gene Boggs</a>
  </footer>

</div>

</body>
</html>
