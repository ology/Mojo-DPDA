% layout 'default';

% my %link = (
%   paranoid     => 'Paranoid_personality_disorder',
%   schizoid     => 'Schizoid_personality_disorder',
%   schizotypal  => 'Schizotypal_personality_disorder',
%   antisocial   => 'Antisocial_personality_disorder',
%   borderline   => 'Borderline_personality_disorder',
%   histrionic   => 'Histrionic_personality_disorder',
%   narcissistic => 'Narcissistic_personality_disorder',
%   avoidant     => 'Avoidant_personality_disorder',
%   dependent    => 'Dependent_personality_disorder',
%   OC           => 'Obsessive%E2%80%93compulsive_personality_disorder',
% );
% my $base = 'https://en.wikipedia.org/wiki/';

<div class="row g-4 align-items-start">
  <div class="col-md-6">
    <img src="<%= url_for("/$chart") %>" class="img-fluid" alt="Your results chart">
  </div>

  <div class="col-md-6">
    <table class="table table-striped table-sm">
      <thead>
        <tr>
          <th>Category</th>
          <th class="text-end">Proportion</th>
          <th>Score - Discord = Diff</th>
        </tr>
      </thead>
      <tbody>
        % for my $category (sort { $order->{$a} <=> $order->{$b} } keys %$order) {
          <tr>
            <td><a href="<%= $base . ($link{$category} // $category) %>"><%= ucfirst $category %></a></td>
            <td class="text-end fw-bold"><%= sprintf('%.1f', ($prop->{$category} // 0) * 100) %>%</td>
            <td>( <%= $average->{$category} %> - <%= $discord->{$category} %> = <%= $diff->{$category} %> )</td>
          </tr>
        % }
      </tbody>
    </table>
    <p class="small text-muted">
      Red: Score ("disorder")<br>
      Green: Discord ("dishonesty", "ambivalence", "confusion")
    </p>
  </div>
</div>

<p class="mt-4">Link to the question file: <a href="<%= url_for('/dpda-questions.txt') %>">DPDA Questions</a></p>
<p>Link to the code: <a href="https://github.com/ology/Mojo-DPDA">DPDA</a></p>

<h3 class="mt-4">Extreme Cases</h3>
<div class="row g-3">
  <div class="col-sm-4">
    <figure class="figure text-center w-100">
      <img src="<%= url_for('/images/dpda-no-disorder.png') %>" class="figure-img img-fluid rounded border" alt="No disorders">
      <figcaption class="figure-caption">No Disorders</figcaption>
    </figure>
  </div>
  <div class="col-sm-4">
    <figure class="figure text-center w-100">
      <img src="<%= url_for('/images/dpda-inconclusive.png') %>" class="figure-img img-fluid rounded border" alt="Inconclusive">
      <figcaption class="figure-caption">Inconclusive</figcaption>
    </figure>
  </div>
  <div class="col-sm-4">
    <figure class="figure text-center w-100">
      <img src="<%= url_for('/images/dpda-disordered.png') %>" class="figure-img img-fluid rounded border" alt="All disorders">
      <figcaption class="figure-caption">All Disorders</figcaption>
    </figure>
  </div>
</div>

<p class="mt-3 fw-bold">* REMEMBER to save this result page including the chart (e.g. as a PDF). *</p>
